# BSAHI D5 inbound census — VPS host config.
#
# Copy to ~/.bsahi/vps-census.conf and set HOST to your public-IP host.
# The moment that file exists, com.bsahi.collectors picks it up automatically
# (it runs vps_census_pull every hour, gated on this file existing), which merges
# the remote inbound census into data/vps_inbound_census.json.
#
# HOST is exactly what you would pass to ssh.
HOST=ubuntu@203.0.113.10

# Optional: override the remote path of the census file written by
# tools/net/vps-census-node.sh (default shown).
# REMOTE_FILE=/var/lib/bsahi/inbound.json
